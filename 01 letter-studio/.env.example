# Copy this file to `.env` and fill in your key:
#     cp .env.example .env
#
# `.env` is listed in .gitignore and is never committed.
# Never paste a real key into .env.example, into the page, or into a chat window.

OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_OWN_KEY

# Optional. ato-project.md originally called for gpt-5-mini and
# gpt-4o-mini-transcribe; both are scheduled for retirement, so the server
# defaults to their current equivalents. Uncomment to pin different ones.
# OPENAI_TEXT_MODEL=gpt-5.6-luna
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Optional.
# PORT=5173
# OPENAI_BASE_URL=https://api.openai.com/v1
